# Variables de entorno — ANASAC Dashboard
# Copia este archivo a `.env.local` y completa los valores.
# Nunca subas secretos reales a Git.

# --- Supabase (fase posterior; no requerido en modo mock) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo en servidor (nunca en el navegador)
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ANASAC Dashboard

# true = usar datos mock (fase actual)
NEXT_PUBLIC_USE_MOCK_DATA=true
