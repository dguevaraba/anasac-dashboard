# Variables de entorno — ANASAC Dashboard
# Copia este archivo a `.env.local` y completa los valores.
# Nunca subas secretos reales a Git.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo en servidor (nunca NEXT_PUBLIC_). Se usa para crear el primer admin.
SUPABASE_SERVICE_ROLE_KEY=

# Tu Gmail. La primera vez que entres con esta cuenta, se crea el administrador.
ADMIN_BOOTSTRAP_EMAIL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ANASAC Dashboard
